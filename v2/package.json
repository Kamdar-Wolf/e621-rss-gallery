{
  "name": "kamdar-reader-v2",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "start:api": "node dist/apps/api/src/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "worker:once": "tsx apps/worker/src/main.ts --once",
    "worker:watch": "tsx apps/worker/src/main.ts",
    "import:opml": "tsx scripts/import-opml.ts",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "bootstrap:user": "tsx scripts/create-user.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@fastify/cors": "^11.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12",
    "fast-xml-parser": "^5.2.5",
    "html-entities": "^2.6.0",
    "ipaddr.js": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0"
  }
}
