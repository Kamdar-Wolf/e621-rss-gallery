# Copy to .env.production on your own server. Never commit the real file.
# Public DNS record points to your server's IPv4/IPv6 address.
READER_DOMAIN=reader.example.org
# Strong random password. PostgreSQL and the URI below must agree.
READER_DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DATABASE_PASSWORD
# Password in a URL must be percent-encoded if it contains reserved characters.
READER_DATABASE_URL=postgresql://reader:REPLACE_WITH_STRONG_RANDOM_DATABASE_PASSWORD@postgres:5432/reader
# Generate 48+ bytes of cryptographic randomness; never reuse test values.
READER_SESSION_SECRET=REPLACE_WITH_48_BYTE_BASE64_RANDOM_SECRET
